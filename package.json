{
	"name": "@lucashw68/nsdb",
	"version": "0.1.0",
	"description": "Nuxt Supabase DB Layer",
	  "publishConfig": {
    	"registry": "https://npm.pkg.github.com/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Lucashw68/nsdb"
	},
	"exports": {
		".": "./module.ts"
	},
	"dependencies": {
		"ts-morph": "^20.0.0"
	},
	"devDependencies": {
		"@nuxt/kit": "^4.0.1",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"nuxt": "^4.0.1",
		"pinia": "^2.1.4"
	},
  	"scripts": {
		"generate:types": "npx supabase gen types typescript --project-id <id> > types/database.types.ts",
		"generate:models": "tsx scripts/generate-models.ts",
		"generate:stores": "tsx scripts/generate-stores.ts",
		"generate:all": "npm run generate:types && npm run generate:models && npm run generate:stores",
		"publish": "npm publish"
	},
	"files": [
		"module.ts",
		"runtime",
		"scripts"
  	]
}