{
	"name": "@lucashw68/nsdb",
	"version": "0.1.95",
	"type": "module",
	"description": "A Nuxt 3 + Supabase + Pinia integration layer for unified DB access and offline storage.",
	"license": "MIT",
	"keywords": [
		"nuxt",
		"supabase",
		"pinia",
		"store",
		"module",
		"database",
		"layer"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Lucashw68/nsdb"
	},
	"exports": {
		".": "./module.ts",
		"./useSupabaseApi": "./runtime/composables/useSupabaseApi.ts",
		"./useSupabaseApiStorage": "./runtime/composables/useSupabaseApiStorage.ts",
		"./useSupabaseModels": "./runtime/composables/useSupabaseModels.ts",
		"./useNsdbProfile": "./runtime/composables/useNsdbProfile.ts",
		"./useNsdbSchemas": "./runtime/composables/useNsdbSchemas.ts",
		"./types/config": "./types/config.ts",
		"./types/entities": "./types/entities.ts",
		"./types/list": "./types/list.ts",
		"./helpers/config": "./helpers/config.js",
		"./createDbStore": "./runtime/stores/createDbStore.ts",
		"./createSingletonDbStore": "./runtime/stores/createSingletonDbStore.ts"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.56.0",
		"ts-morph": "^20.0.0",
		"tsx": "^4.20.5"
	},
	"devDependencies": {
		"@nuxt/kit": "^4.0.1",
		"pinia": "^3.0.3",
		"typescript": "^5.0.0",
		"vue": "^3.5.18"
	},
	"peerDependencies": {
		"nuxt": "^4.0.1",
		"pinia": "^2.1.4",
		"@pinia-plugin-persistedstate/nuxt": "^1.2.1",
		"supabase": "^2.39.2"
	},
	"bin": {
		"nsdb": "./cli/index.js"
	},
	"scripts": {
		"generate:types": "node ./scripts/generate-types.js",
		"generate:enums": "node ./scripts/generate-enums.js",
		"generate:schemas": "node ./scripts/generate-schemas.js",
		"generate:models": "node ./scripts/generate-models.js",
		"generate:composables": "node ./scripts/generate-composables.js",
		"generate:stores": "node ./scripts/generate-stores.js",
		"generate:all": "npm run generate:types && npm run generate:enums && npm run generate:schemas && npm run generate:models && npm run generate:stores && npm run generate:composables",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit",
		"test": "node --test \"tests/**/*.test.mjs\"",
		"prepublishOnly": "npm run check && npm test",
		"clear": "node scripts/clear.js"
	},
	"files": [
		"GET_STARTED.md",
		"module.ts",
		"runtime",
		"scripts",
		"templates",
		"helpers",
		"cli",
		"types",
		"nsdb.config.example.ts",
		"nsdb.config.example.mjs"
	],
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
